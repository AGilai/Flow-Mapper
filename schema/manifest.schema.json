{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AGilai/flow-mapper/schema/manifest.schema.json",
  "title": "Flow-Mapper harvest manifest",
  "description": "One service's harvested map. kind=full replaces the snapshot; kind=delta patches it against baseVersion.",
  "oneOf": [{ "$ref": "#/$defs/fullManifest" }, { "$ref": "#/$defs/deltaManifest" }],

  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:\\-/{}#*]+$",
      "minLength": 1,
      "description": "Stable ID, unique within the service for its entity type."
    },
    "bindKey": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque key produced by the harvester. Literal unless match=glob."
    },
    "match": {
      "enum": ["exact", "glob"],
      "default": "exact",
      "description": "glob: '*' matches any characters except '/', '**' matches anything."
    },
    "transport": {
      "enum": ["http", "rpc", "grpc", "sns", "sqs", "amqp", "eventbridge", "cron", "event", "other"]
    },
    "delivery": {
      "enum": ["unicast", "multicast"],
      "description": "unicast links to the most specific match; multicast to all matches. Defaults by transport."
    },
    "mode": { "enum": ["sync", "async"] },
    "version": { "type": "integer", "minimum": 1 },
    "env": { "type": "string", "pattern": "^[a-z0-9\\-]+$", "default": "default" },
    "eventType": {
      "type": "string",
      "minLength": 1,
      "description": "Event type name as the harvester sees it (message type attribute, detail-type, class name). Matched exactly; 'OrderPlaced.v2' is not 'OrderPlaced'."
    },
    "eventPattern": {
      "type": "string",
      "minLength": 1,
      "description": "An event type, or a glob over event types: '*' for all, 'Order*' for a prefix."
    },
    "eventFilter": {
      "oneOf": [
        { "const": "*" },
        { "type": "array", "items": { "$ref": "#/$defs/eventPattern" } }
      ],
      "description": "Event types a subscription lets through. Absent means all. An entry starting with '!' excludes a type or glob (SNS anything-but / prefix exclusion): [\"!revision.status\"] is everything except that type; [\"Order*\", \"!OrderDraft*\"] is Order types except drafts."
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the item is defined (code or IaC). commit and repo override the manifest's for this item's code link; set commit only when this item was scanned at a different commit.",
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "col": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "repo": { "type": "string" },
        "commit": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Which harvester run produced the item, and whether it was checked against the live system.",
      "properties": {
        "producer": { "type": "string" },
        "runId": { "type": "string" },
        "verified": { "enum": ["match", "drift", "code-only"] }
      }
    },
    "via": {
      "type": "array",
      "description": "Wrapper hops between the caller's call site and the real SDK call, in call order (the last hop is the one that calls the SDK). The call still counts once: hops are never producers, nodes or edges.",
      "items": {
        "type": "object",
        "required": ["function"],
        "additionalProperties": false,
        "properties": {
          "function": { "type": "string", "description": "The wrapper, e.g. SNSManager.publish." },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "col": { "type": "integer", "minimum": 1 },
          "kind": { "type": "string", "default": "wrapper" },
          "repo": { "type": "string" },
          "commit": { "type": "string" }
        }
      }
    },
    "driverRef": {
      "type": "object",
      "required": ["package"],
      "additionalProperties": false,
      "properties": {
        "package": { "type": "string", "description": "Package name, e.g. ioredis." },
        "version": { "type": "string", "description": "Resolved version, e.g. 5.3.2. Leave out (and send unresolved what=client) when unknown; never invent one." },
        "versionSource": { "type": "string", "description": "Where the version came from: lockfile, package.json, …" }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "description": "How a service reaches a data store (on a resource) or a non-store target (on an egress): its access mode, its own driver, and the wrapper library with the driver bundled in it. One client per client site; a service that reaches one store in two ways sends two resources.",
      "properties": {
        "accessMode": { "enum": ["direct_driver", "shared_lib", "self_implemented_wrapper", "third_party_lib"] },
        "accessId": { "type": "string", "description": "Stable id of the client site, e.g. orders-svc/src/redis.ts:12." },
        "driver": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/driverRef" }], "description": "The service's own driver." },
        "lib": {
          "description": "The wrapper library and the driver it bundles; null or omitted for direct_driver.",
          "oneOf": [{ "type": "null" }, {
            "type": "object",
            "required": ["package"],
            "additionalProperties": false,
            "properties": {
              "package": { "type": "string" },
              "kind": { "enum": ["in_house", "third_party"] },
              "version": { "type": "string" },
              "versionSource": { "type": "string" },
              "driver": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/driverRef" }], "description": "The driver nested inside the library (it may differ from the service's own)." }
            }
          }]
        },
        "via": { "$ref": "#/$defs/via", "description": "Wrapper hops from the caller to the SDK call, same shape as egress `via`." }
      }
    },
    "callSite": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "description": "One place in the service's code that makes this call, with the wrappers it goes through.",
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "function": { "type": "string", "description": "The caller's function." },
        "via": { "$ref": "#/$defs/via" }
      }
    },
    "unresolved": {
      "type": "array",
      "description": "What the harvester found but could not resolve, and why. what=target: the call target or consumed key (bindKey, or a step's target, may then be left out). what=event: the event type (candidates = the possible types). what=client (on a resource or egress): a field of its `client` the harvester could not resolve; `detail` names the field (e.g. driver.version or lib.driver.version), `reason` says why (e.g. lockfile_not_found). what=caller (on a function): the backward walk stopped here because no caller could be resolved (reason e.g. unknown_receiver, callback_passed; candidates = possible callers, as function ids).",
      "items": {
        "type": "object",
        "required": ["what", "reason"],
        "additionalProperties": false,
        "properties": {
          "what": { "enum": ["target", "event", "caller", "client"] },
          "reason": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" },
          "candidates": { "type": "array", "items": { "type": "string" }, "description": "Possible bind keys (target) or event types (event)." }
        }
      }
    },

    "details": {
      "type": "object",
      "description": "Free-form transport details (method, path, queue URL, timeouts, …).",
      "additionalProperties": true
    },

    "service": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9\\-]+$" },
        "kind": { "enum": ["service", "gateway", "lambda", "infra"], "default": "service" },
        "team": { "type": "string" },
        "repo": { "type": "string" },
        "language": { "type": "string" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },

    "step": {
      "type": "object",
      "required": ["seq", "type"],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "type": { "enum": ["call", "egress", "resource"] },
        "target": { "$ref": "#/$defs/id", "description": "Function id, egress id or resource id in this service." },
        "mode": { "$ref": "#/$defs/mode", "default": "sync" },
        "operation": { "type": "string", "description": "e.g. findOne, publish, GET" },
        "condition": { "type": "string", "description": "Branch condition, if conditional." },
        "loop": { "type": "boolean", "default": false },
        "note": { "type": "string" },
        "event": { "$ref": "#/$defs/eventType", "description": "For an egress step: the event type it publishes." },
        "unresolved": { "$ref": "#/$defs/unresolved" },
        "source": { "$ref": "#/$defs/source", "description": "Where the call is made: file, line, col. Shown as a code link on the trace message." },
        "access": { "enum": ["read", "write", "read_write"], "description": "For a resource step: read, write or read_write (e.g. findOneAndUpdate; shown as R/W, counts as reader and writer). Default: from the operation name (find, GET, SELECT, GetItem… are reads)." },
        "fields": {
          "type": "array",
          "description": "For a resource step: the fields of the stored object this call touches, names only, never values.",
          "items": {
            "type": "object", "required": ["role", "path"], "additionalProperties": false,
            "properties": {
              "role": { "enum": ["filter", "projection", "update", "sort"] },
              "path": { "type": "string", "description": "Field path, e.g. status or address.city." },
              "operator": { "type": "string", "description": "e.g. $eq, $in, $set, $inc, asc." },
              "inDdl": { "type": "boolean", "description": "false: the code uses a field that is not in the collection's schema (flagged in the UI and the contract report)." },
              "ddlRef": { "type": "string", "description": "Link to the schema/DTO field, e.g. Order.status." },
              "flag": { "type": "string", "description": "Free-text remark about the field." }
            }
          }
        },
        "origin": { "enum": ["path", "frontier"], "default": "path", "description": "'frontier': part of a call tree that reaches no sink. Traces fold frontier steps into one marker per function and do not count them toward maxMessages unless asked to expand them. Default 'path': as before." },
        "kind": { "enum": ["leaf"], "description": "'leaf': a step that ends the call tree and has no target (db_access, external_pkg…); say what it is in `operation` and `note`. A `call` step with no target but an `operation` or `note` is a leaf too. Not an unresolved gap." }
      }
    },

    "function": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "commit": { "type": "string", "description": "Only when this function was scanned at a different commit than the manifest's." },
        "unresolved": { "$ref": "#/$defs/unresolved" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" }, "default": [] }
      }
    },

    "ingress": {
      "type": "object",
      "required": ["id", "transport", "handler"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "bindKey": { "$ref": "#/$defs/bindKey" },
        "match": { "$ref": "#/$defs/match" },
        "transport": { "$ref": "#/$defs/transport" },
        "handler": { "$ref": "#/$defs/id", "description": "Function id that handles this ingress." },
        "entryPoint": { "type": "boolean", "default": false, "description": "Public API, cron, etc. Excluded from orphan stats." },
        "details": { "$ref": "#/$defs/details" },
        "source": { "$ref": "#/$defs/source" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "unresolved": { "$ref": "#/$defs/unresolved" },
        "via": { "$ref": "#/$defs/via", "description": "How the handler was resolved, for registrations that are not a direct reference: hops from the registration to the handler, each kind 'registration' or 'bind'. `details.handlerVia` is still accepted." },
        "events": {
          "type": "array",
          "description": "Event types this consumer handles, each with its own handler. The most specific match wins.",
          "items": {
            "type": "object",
            "required": ["type", "handler"],
            "additionalProperties": false,
            "properties": {
              "type": { "$ref": "#/$defs/eventPattern" },
              "handler": { "$ref": "#/$defs/id", "description": "Function id that handles this event type." },
              "producers": { "type": "array", "items": { "type": "string" }, "description": "Declared producer services, for producers Flow-Mapper does not harvest. Harvested producers are found automatically." }
            }
          }
        }
      }
    },

    "egress": {
      "type": "object",
      "required": ["id", "transport"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "bindKey": { "$ref": "#/$defs/bindKey" },
        "transport": { "$ref": "#/$defs/transport" },
        "mode": { "$ref": "#/$defs/mode" },
        "delivery": { "$ref": "#/$defs/delivery" },
        "details": { "$ref": "#/$defs/details" },
        "source": { "$ref": "#/$defs/source" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "unresolved": { "$ref": "#/$defs/unresolved" },
        "events": { "type": "array", "items": { "$ref": "#/$defs/eventType" }, "description": "Event types published through this egress." },
        "via": { "$ref": "#/$defs/via" },
        "client": { "$ref": "#/$defs/client" },
        "callSites": { "type": "array", "items": { "$ref": "#/$defs/callSite" }, "description": "Every place that makes this call, each with its own `via`. `details.via` and `details.callSites` are still accepted." }
      }
    },

    "resource": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "type": "string", "examples": ["mongodb", "redis", "dynamodb", "postgres", "s3", "elasticsearch"] },
        "name": { "type": "string" },
        "unresolved": { "$ref": "#/$defs/unresolved" },
        "bindKey": { "$ref": "#/$defs/bindKey", "description": "Shared key so services using the same store are grouped: {kind}:{cluster or db}/{collection, table or key pattern}, e.g. mongodb:orders-db/orders, redis:cache-main/order:{id}. The part before '/' groups keys of one cluster." },
        "client": { "$ref": "#/$defs/client" },
        "details": { "$ref": "#/$defs/details" },
        "source": { "$ref": "#/$defs/source" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "channel": {
      "type": "object",
      "required": ["bindKey", "kind"],
      "additionalProperties": false,
      "properties": {
        "bindKey": { "$ref": "#/$defs/bindKey" },
        "kind": { "enum": ["sns-topic", "sqs-queue", "amqp-exchange", "amqp-queue", "eventbridge-bus", "other"] },
        "name": { "type": "string" },
        "delivery": { "$ref": "#/$defs/delivery" },
        "details": { "$ref": "#/$defs/details" },
        "source": { "$ref": "#/$defs/source" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "binding": {
      "type": "object",
      "required": ["id", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/bindKey", "description": "Source channel key, or a pattern when match=glob." },
        "match": { "$ref": "#/$defs/match" },
        "to": { "$ref": "#/$defs/bindKey", "description": "Target channel or ingress key (literal)." },
        "filter": { "type": "object", "additionalProperties": true, "description": "e.g. SNS filter policy" },
        "events": { "$ref": "#/$defs/eventFilter" },
        "details": { "$ref": "#/$defs/details" },
        "source": { "$ref": "#/$defs/source" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },

    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } },
        "ingress": { "type": "array", "items": { "$ref": "#/$defs/ingress" } },
        "egress": { "type": "array", "items": { "$ref": "#/$defs/egress" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } }
      }
    },

    "deleteLists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "functions": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "ingress": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "egress": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "channels": { "type": "array", "items": { "$ref": "#/$defs/bindKey" } },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/id" } }
      }
    },

    "header": {
      "type": "object",
      "required": ["schemaVersion", "kind", "service", "version", "harvestedAt"],
      "properties": {
        "schemaVersion": { "const": "1.0" },
        "env": { "$ref": "#/$defs/env" },
        "service": { "$ref": "#/$defs/service" },
        "version": { "$ref": "#/$defs/version" },
        "harvestedAt": { "type": "string", "format": "date-time" },
        "commit": { "type": "string" }
      }
    },

    "fullManifest": {
      "allOf": [{ "$ref": "#/$defs/header" }],
      "properties": {
        "schemaVersion": true, "env": true, "service": true, "version": true,
        "harvestedAt": true, "commit": true,
        "kind": { "const": "full" },
        "functions": { "$ref": "#/$defs/entities/properties/functions" },
        "ingress": { "$ref": "#/$defs/entities/properties/ingress" },
        "egress": { "$ref": "#/$defs/entities/properties/egress" },
        "resources": { "$ref": "#/$defs/entities/properties/resources" },
        "channels": { "$ref": "#/$defs/entities/properties/channels" },
        "bindings": { "$ref": "#/$defs/entities/properties/bindings" }
      },
      "unevaluatedProperties": false
    },

    "deltaManifest": {
      "allOf": [{ "$ref": "#/$defs/header" }],
      "required": ["baseVersion"],
      "properties": {
        "schemaVersion": true, "env": true, "service": true, "version": true,
        "harvestedAt": true, "commit": true,
        "kind": { "const": "delta" },
        "baseVersion": { "$ref": "#/$defs/version" },
        "upsert": { "$ref": "#/$defs/entities" },
        "delete": { "$ref": "#/$defs/deleteLists" }
      },
      "unevaluatedProperties": false
    }
  }
}
