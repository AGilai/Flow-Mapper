[Unit]
Description=Litestream: continuous SQLite replication to S3
After=network-online.target
Wants=network-online.target
# Never start (and so never create an empty database) on the root disk when the data volume is not mounted.
RequiresMountsFor=/var/lib/flow-mapper

[Service]
Type=simple
User=flowmapper
Group=flowmapper
EnvironmentFile=/etc/flow-mapper.env
ExecStart=/usr/bin/litestream replicate -config /etc/litestream.yml
Restart=always
RestartSec=5
ReadWritePaths=/var/lib/flow-mapper
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
