%% Flow: users-svc · in.getPosture
sequenceDiagram
actor caller as caller
participant users_svc as users-svc
participant postgres_users_db_users as postgres:users-db/users
participant redis_cache_main_user_id as redis:cache-main/user:{id}
participant auth_svc as auth-svc
