{
  "env": "prod",
  "schemas": [
    {
      "key": "mongodb:orders-db/orders", "source": "code",
      "content": {
        "model": "Order (src/models/order.ts)",
        "fields": { "_id": "ObjectId", "orderId": "string", "customerId": "string", "status": "PENDING_PAYMENT | PAID | SHIPPED | CANCELLED",
          "items": [{ "sku": "string", "quantity": "number", "unitPrice": "number" }], "total": "number", "currency": "string", "createdAt": "Date" },
        "indexes": [{ "keys": { "orderId": 1 }, "unique": true }, { "keys": { "customerId": 1, "createdAt": -1 } }]
      }
    },
    {
      "key": "mongodb:catalog-db/products", "source": "code",
      "content": {
        "model": "Product (src/models/product.model.ts)",
        "fields": { "_id": "ObjectId", "sku": "string", "name": "string", "brandId": "string", "categoryIds": ["string"],
          "status": "DRAFT | PUBLISHED | ARCHIVED", "variants": [{ "id": "string", "size": "string", "color": "string" }], "updatedAt": "Date" },
        "indexes": [{ "keys": { "sku": 1 }, "unique": true }, { "keys": { "categoryIds": 1, "status": 1 } }, { "keys": { "name": "text" } }]
      }
    },
    {
      "key": "redis:cache-main/order:{id}", "source": "code",
      "content": { "keyPattern": "order:{id}", "type": "string", "value": "JSON of Order", "ttlSeconds": 300, "writtenBy": "OrderService.place" }
    },
    {
      "key": "redis:cache-main/product:{id}:availability", "source": "code",
      "content": { "keyPattern": "product:{id}:availability", "type": "hash", "fields": { "inStock": "0 | 1", "quantity": "number", "updatedAt": "ISO date" }, "ttlSeconds": 60 }
    },
    {
      "key": "dynamodb:payments", "source": "code",
      "content": {
        "table": "payments", "partitionKey": { "name": "paymentId", "type": "S" }, "sortKey": null,
        "globalSecondaryIndexes": [{ "name": "byOrder", "partitionKey": { "name": "orderId", "type": "S" } }],
        "item": { "paymentId": "p_99a", "orderId": "o_5531", "amount": 103.8, "currency": "EUR", "status": "SUCCEEDED" }
      }
    },
    {
      "key": "postgres:users-db/users", "source": "code",
      "content": {
        "table": "users", "columns": { "id": "uuid primary key", "email": "text unique not null", "name": "text", "tier": "text default 'free'", "created_at": "timestamptz" },
        "indexes": ["users_email_key (email)"]
      }
    },
    {
      "key": "mongodb:p81-cluster/_User", "source": "manual",
      "content": {
        "fields": { "_id": "ObjectId", "tenantId": "string", "email": { "type": "string", "required": true, "description": "login name, lower-cased" }, "deliveryState": "pending | done | failed", "loginInstanceId": "NetworkDevice._id",
          "devices": [{ "deviceId": "string", "lastSeen": "date" }], "profile": { "displayName": "string", "locale": "string" } },
        "indexes": [{ "name": "by_email", "keys": { "tenantId": 1, "email": 1 }, "unique": true }, { "keys": { "deliveryState": 1 } }],
        "incomplete": true,
        "doc": { "file": "hld/auth.md", "section": "4.1 Users", "quote": "A user belongs to one tenant and has devices.", "confidence": "inferred" },
        "$comment": "fields from the HLD text, not from code"
      }
    },
    {
      "key": "mongodb:p81-cluster/Group", "source": "code",
      "content": {
        "$schema": "http://json-schema.org/draft-07/schema#", "type": "object", "required": ["name"],
        "properties": { "name": { "type": "string", "description": "group name" }, "kind": { "type": "string", "enum": ["team", "org"] }, "memberIds": { "type": "array", "items": { "type": "string" } } }
      }
    },
    {
      "key": "mongodb:p81-cluster/Org", "source": "manual",
      "content": { "note": "Org documents are described in the HLD, no field list yet", "doc": { "file": "hld/auth.md", "section": "4.2", "confidence": "stated" } }
    },
    {
      "key": "mongodb:identity-db/users", "source": "code",
      "content": {
        "type": "object", "required": ["_id", "email", "createdAt"],
        "properties": {
          "_id": { "type": "ObjectId", "description": "primary key" },
          "email": { "type": "string", "description": "unique, lowercase" },
          "emailVerified": { "type": "boolean", "description": "default false" },
          "roles": { "type": "array", "items": { "type": "string" } },
          "profile": { "type": "object", "properties": {
            "displayName": { "type": "string" }, "locale": { "type": "string" },
            "avatar": { "type": "object", "properties": { "url": { "type": "string" }, "updatedAt": { "type": "date" } } } } },
          "devices": { "type": "array", "items": { "type": "object", "required": ["deviceId"], "properties": { "deviceId": { "type": "string" }, "pushToken": { "type": "string" }, "lastSeenAt": { "type": "date" } } } },
          "lastLoginAt": { "type": "date" },
          "createdAt": { "type": "date" }
        }
      }
    },
    {
      "key": "mongodb:identity-db/audit_events", "source": "manual",
      "content": { "fields": { "actor": "string", "action": "string", "at": "date", "detail": { "type": "object", "fields": { "ip": "string", "target": "string" } } }, "indexes": [{ "keys": { "at": -1 } }] }
    }
  ]
}
