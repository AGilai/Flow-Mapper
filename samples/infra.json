{
  "schemaVersion": "1.0",
  "kind": "full",
  "env": "prod",
  "service": {
    "name": "infra",
    "kind": "infra",
    "team": "platform",
    "repo": "github.com/acme/infra",
    "description": "Topics, queues and exchanges declared in IaC"
  },
  "version": 5,
  "harvestedAt": "2026-10-19T08:00:00Z",
  "commit": "5e03a58",
  "channels": [
    {
      "bindKey": "sns:order-events",
      "kind": "sns-topic",
      "name": "order-events"
    },
    {
      "bindKey": "sns:payment-events",
      "kind": "sns-topic",
      "name": "payment-events"
    },
    {
      "bindKey": "sns:payment-disputes",
      "kind": "sns-topic",
      "name": "payment-disputes"
    },
    {
      "bindKey": "sqs:orders-dlq",
      "kind": "sqs-queue",
      "name": "orders-dlq"
    },
    {
      "bindKey": "amqp:shipping",
      "kind": "amqp-exchange",
      "name": "shipping",
      "details": {
        "type": "topic"
      }
    },
    {
      "bindKey": "eventbridge:acme-bus",
      "kind": "eventbridge-bus",
      "name": "acme-bus",
      "details": {
        "arn": "arn:aws:events:eu-west-1:000000000000:event-bus/acme-bus"
      }
    }
  ],
  "bindings": [
    {
      "id": "sub.shipping",
      "from": "sns:order-events",
      "to": "sqs:shipping-order-events",
      "events": [
        "OrderPlaced"
      ]
    },
    {
      "id": "rule.userEvents",
      "from": "eventbridge:acme-bus",
      "to": "sqs:analytics-all-events",
      "events": [
        "User*"
      ]
    }
  ]
}
